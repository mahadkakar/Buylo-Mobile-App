EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Django backend. NOTE: "localhost" won't reliably reach the dev server
# from a physical device or some emulators — use your dev machine's LAN IP
# (e.g. http://192.168.1.23:8000) or an Expo tunnel URL instead.
EXPO_PUBLIC_API_URL=http://localhost:8000
