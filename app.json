{
  "expo": {
    "name": "Buylo",
    "slug": "basket-compare",
    "scheme": "basketcompare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.basketcompare.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.basketcompare.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#0A0A1F", "image": "./assets/splash-icon.png", "imageWidth": 220 }],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Buylo uses your location to find participating grocery stores near you and show accurate nearby prices."
        }
      ],
      "expo-web-browser"
    ]
  }
}
